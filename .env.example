PROVIDER=live
API_HOST=127.0.0.1
API_PORT=8787
ALLOWED_EXTENSION_ORIGIN=chrome-extension://replace-with-your-extension-id
BACKEND_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Leave effort blank for models without configurable reasoning.
OPENAI_REASONING_EFFORT=low
ANALYSIS_TIMEOUT_MS=60000
MAX_OUTPUT_TOKENS=8000

# Opt in after verifying image input + structured output support for this model.
IMAGE_ANALYSIS_ENABLED=false
OPENAI_IMAGE_MODEL=
# Blank inherits OPENAI_REASONING_EFFORT. Use none to disable reasoning for images.
OPENAI_IMAGE_REASONING_EFFORT=medium
IMAGE_MAX_OUTPUT_TOKENS=4000
# Conservative per-batch cost reservation, not a provider billing guarantee.
# Set for your chosen model's current prices. Failed attempts consume reservations too.
IMAGE_BATCH_BUDGET_USD=0.10
IMAGE_RUN_BUDGET_USD=2

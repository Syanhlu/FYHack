{
  "name": "profile-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,profiles,extension \"pnpm dev:api\" \"pnpm dev:profiles\" \"pnpm --dir apps/extension dev\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:profiles": "vite apps/demo-profiles --host localhost --port 4173 --strictPort",
    "demo": "concurrently -k -n api,profiles \"pnpm dev:api\" \"pnpm dev:profiles\"",
    "build": "pnpm --dir apps/extension build && pnpm typecheck",
    "build:test": "node scripts/build-test.mjs",
    "typecheck": "pnpm --dir apps/extension prepare && tsc --noEmit && tsc --noEmit -p apps/extension/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "pnpm build:test && playwright test",
    "lint": "eslint .",
    "eval:live": "node --import tsx scripts/eval-live.ts",
    "package:demo": "pnpm --dir apps/extension zip",
    "eval:images": "node --import tsx scripts/eval-images.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}

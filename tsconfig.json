{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "chrome", "vitest/globals"]
  },
  "include": ["apps/api", "packages", "tests", "scripts", "*.config.ts"],
  "exclude": ["node_modules", "apps/extension/.output", "apps/extension/.wxt"]
}
